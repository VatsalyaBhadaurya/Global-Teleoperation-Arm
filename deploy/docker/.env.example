# Copy to .env and edit before running `docker compose up`.

# Shared secret that gateways and operators must present as `token` in
# session.join. Leave empty to disable auth (dev only).
TELEOP_API_KEY=

# Seconds an operator's ownership claim survives after their websocket
# disconnects before it is automatically released.
TELEOP_CLAIM_TIMEOUT_S=5.0

# Seconds without a teleop.heartbeat before a participant is considered stale.
TELEOP_HEARTBEAT_TIMEOUT_S=15.0

# wss:// URL of the signaling server, baked into the operator-ui static
# build at image-build time.
VITE_SIGNALING_URL=wss://teleop.example.com/ws

# coturn settings -- must match deploy/coturn/turnserver.conf.
TURN_REALM=teleop.example.com
TURN_USER=teleop
TURN_PASSWORD=change-me
